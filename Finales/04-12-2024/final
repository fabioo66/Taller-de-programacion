programa nombre
procesos
  proceso darseVuelta
  comenzar
    repetir 2
      derecha
  fin
  proceso izquierda
  comenzar
    repetir 3
      derecha
  fin
  proceso tirarFlores
  comenzar
    mientras(HayFlorEnLaBolsa)
      depositarFlor
  fin
  proceso juntarFlores
  comenzar
    mientras(HayFlorEnLaEsquina)
      tomarFlor
  fin
  proceso depositarFlores(E avInicial: numero; E caInicial: numero E av: numero; E ca: numero)
  comenzar
    BloquearEsquina(av, ca)
    Pos(av, ca)
    tirarFlores
    Pos(avInicial, caInicial)
    LiberarEsquina(av,ca)
  fin
  proceso recorrido(E cant: numero)
  comenzar
    repetir cant
      juntarFlores
      mover
    juntarFlores
  fin
